library(dplyr)
knitr::opts_chunk$set(echo = FALSE)
result <- data.frame (
Model = c('OLS', 'Elastic Net', 'GAM', 'RFR', 'XGBoost'),
RMSE = c(10.33, 10.55, 10.07, 10.25, 9.79),
R2 = c(0.82, 0.81, 0.82, 0.8180, 0.8438)
)
result %>%
kable(
caption = "Model Performance",
booktabs = TRUE,
align = c('1', rep('c', 5))
) %>%
kableExtra::kable_styling(
bootstrap_options = c('striped', 'condensed'),
font_size = 10,
latex_options = "HOLD_position"
)
View(result)
