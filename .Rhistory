# The MLE is simply the best-fitting parameter value. There is no distribution
# over theta just a single point estimate.
# the MLE is just a point estimate in a frequentist setting, whereas a
# Bayesian approach would yield a posterior distribution for theta
joiner <-
rep(59:75,
c(3, 5, 7, 12, 16, 23, 23, 18, 15, 16, 23, 21, 13, 19, 8, 9, 3))
# load package
library(mixtools)
set.seed(440)    # reproducability
mix <- normalmixEM2comp(
x = joiner,
lambda = c(.5, .5), # initial mixing prop
mu = c(65, 70),     # init guess for mu and sig^2
sigsqrd= c(4, 4),
)
# Inspect the MLEs:
cat("Estimated proportion (lambda):\n")
print(mix$lambda)    # for male and females
cat("Estimated means (mu):\n")
print(mix$mu)       # u1, u2
cat("Common sd (sigma):\n")
print(mix$sigma)    # sig1, sig2
# hist
