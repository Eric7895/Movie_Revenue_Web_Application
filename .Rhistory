n = 10000 # number of samples
x = rep(0,n) # to store the samples
shape = c(2,2) # shapes of the two components
scale = c(0.5,1) # scales of the two components
for(i in 1:n){
if(runif(1)<0.7)
z=1 else z=2
x[i] = rgamma(1,scale=scale[z],shape=shape[z])
}
