lines(xseq, dgamma(xseq, 2, scale=1), col=3, lwd=3)
lines(xseq, .7*dgamma(xseq, 2, scale=0.5) + 0.3*dgamma(xseq, 2, scale=1), col=4 , lwd=3)
# compute log-lik
mix_loglik = function(pi1,x){
sum(log(pi1 * dgamma(x,scale=0.5,shape=2) +
(1-pi1)*dgamma(x,scale=1,shape=2)))
}
pi1seq <- seq(0, 1, len=200)
loglikepi1 <- rep(0, 200)
for(i in 1:200) {
loglikepi1[i] <-mix_loglik(pi1seq)
}
